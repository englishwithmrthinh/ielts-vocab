# Dán các giá trị thật vào Netlify → Site configuration → Environment variables.
# Chạy thử trên máy: copy file này thành .env (KHÔNG commit .env).

# Supabase (Project Settings → API)
SUPABASE_URL=
# Key bí mật: loại mới sb_secret_… hoặc service_role cũ đều được
SUPABASE_SERVICE_ROLE_KEY=

# Phiên đăng nhập: chuỗi ngẫu nhiên dài ≥ 32 ký tự
SESSION_SECRET=
# Mật khẩu trang quản trị của giáo viên
ADMIN_PASSWORD=

# ElevenLabs (Claude 3 dùng)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Gemini — Google AI Studio: chỉ dùng model chữ cho nhận xét tháng (ảnh vẽ tay bằng app Gemini)
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=
# Ảnh minh hoạ: manual = giáo viên vẽ bằng app Gemini rồi tải lên (mặc định); auto = gọi Gemini API (tốn phí)
IMAGE_MODE=manual

# Google Sheets báo cáo (Sếp dùng)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Private key của service account, giữ nguyên các ký tự \n
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=

# Địa chỉ web đã deploy, dùng để tạo link phụ huynh, ví dụ https://ten-site.netlify.app
PUBLIC_SITE_URL=https://hoctuvung-mrthinhclass.netlify.app

# Chỉ dùng khi chạy giao diện không cần backend (true = dữ liệu giả). Trên Netlify để trống.
VITE_USE_MOCK=
