{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ielts-vocab.app/schemas/skill-words.schema.json",
  "title": "IELTS Vocabulary Lesson Output Schema",
  "description": "JSON Schema validating the vocabulary list generated by the Claude Skill for Admin import.",
  "type": "object",
  "required": ["words"],
  "additionalProperties": false,
  "properties": {
    "words": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "word",
          "pos",
          "meaning_vi",
          "ipa",
          "syllables",
          "example",
          "word_family",
          "image_hint"
        ],
        "additionalProperties": false,
        "properties": {
          "word": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+(?:\\s+\\S+)*$",
            "description": "Target English word or phrase in base form."
          },
          "pos": {
            "type": "string",
            "enum": ["n", "v", "adj", "adv", "prep", "conj", "phr"],
            "description": "Part of speech."
          },
          "meaning_vi": {
            "type": "string",
            "minLength": 1,
            "pattern": "^\\S+(?:\\s+\\S+){0,5}$",
            "description": "Concise Vietnamese meaning in IELTS context (maximum 6 space-separated words)."
          },
          "ipa": {
            "type": "string",
            "pattern": "^/.+/$",
            "description": "British English IPA transcription enclosed in slashes."
          },
          "syllables": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?=.*[A-Z])[A-Za-z·\\-\\s]+$",
            "description": "Syllable breakdown separated by middle dots (·) with stressed syllable in UPPERCASE."
          },
          "example": {
            "type": "string",
            "pattern": "^\\S+(?:\\s+\\S+){7,17}$",
            "description": "B2-C1 example sentence (8 to 18 words) containing the exact base form of the word."
          },
          "word_family": {
            "type": "array",
            "minItems": 0,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": ["form", "pos", "sentence"],
              "additionalProperties": false,
              "properties": {
                "form": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^\\S+(?:\\s+\\S+)*$"
                },
                "pos": {
                  "type": "string",
                  "enum": ["n", "v", "adj", "adv", "prep", "conj", "phr"]
                },
                "sentence": {
                  "type": "string",
                  "pattern": "^(?:(?!___).)*___(?:(?!___).)*$",
                  "description": "Cloze sentence containing exactly one '___' placeholder."
                }
              }
            }
          },
          "image_hint": {
            "type": "string",
            "minLength": 10,
            "description": "Concrete visual description in English without any text, numbers, or symbols."
          }
        }
      }
    }
  }
}
